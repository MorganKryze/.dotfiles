# Add `~/bin` to the `$PATH`
export PATH="$HOME/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="/opt/X11/bin:$PATH"

# .NET
export PATH="$PATH:/usr/local/share/dotnet"

# Flutter
# export PATH="$PATH:/Users/morgan/Documents/02-dev/05-tools/flutter/bin"
# export PATH="$PATH":"$HOME/.pub-cache/bin"
export PATH="$PATH:$HOME/fvm/default/bin"

# Rust
#. "$HOME/.cargo/env"
#. /opt/homebrew/etc/profile.d/z.sh

# Java
export JAVA_HOME=/opt/homebrew/opt/java
export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"

# MySQL
export PATH=${PATH}:/usr/local/mysql/bin/

# Prefer US English and use UTF-8.
# export LANG='en_US.UTF-8'
# export LC_ALL='en_US.UTF-8'

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
*":$PNPM_HOME:"*) ;;
*) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# TexLive
export PATH="/Library/TeX/texbin:$PATH"

# Yazi
export EDITOR="micro"

# Curl
export PATH="/opt/homebrew/opt/curl/bin:$PATH"

# SOPS
export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
# SSH — réparer un agent hérité mort.
# Les clés sont chargées dans l'agent de launchd par le service `ssh-add-keychain`. Mais tout
# processus lancé depuis un terminal qui imposait SON propre agent (WezTerm le fait par défaut)
# hérite d'un SSH_AUTH_SOCK qui devient une socket MORTE dès que ce terminal ferme — et le transmet
# à ses enfants. Symptôme : « Error connecting to agent: No such file or directory » alors que les
# clés sont bien chargées, ailleurs. Vécu le 2026-08-11 dans le terminal de VS Code.
# On ne force rien : on ne réécrit la variable que si elle ne désigne PAS une socket vivante.
if [ ! -S "${SSH_AUTH_SOCK:-}" ]; then
  _launchd_ssh_sock="$(launchctl getenv SSH_AUTH_SOCK 2>/dev/null)"
  [ -S "$_launchd_ssh_sock" ] && export SSH_AUTH_SOCK="$_launchd_ssh_sock"
  unset _launchd_ssh_sock
fi
